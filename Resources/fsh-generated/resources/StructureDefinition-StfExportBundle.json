      },
      {
        "id": "Bundle.timestamp",
        "path": "Bundle.timestamp",
        "short": "Exportzeitpunkt",
        "mustSupport": true
      },
      {
        "id": "Bundle.entry",
        "path": "Bundle.entry",
        "mustSupport": true
      },
      {
        "id": "Bundle.entry.fullUrl",
