        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Observation.component:Details.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "todesursacheKlassifikation",
