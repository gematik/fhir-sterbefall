meta {
  name: Only $receiveBundle accessible
  type: http
  seq: 3
  tags: [
    ga
  ]
}

get {
  url: {{host}}/Patient
  body: none
  auth: inherit
}

assert {
  res.status: in 401, 200
}

tests {
  test("SEARCHSET or OperationOutcome: Empty searchset or valid OperationOutcome or 401", () => {
    const status = res.getStatus();
    if (status === 401) {
      console.log("Skipping test because response status is 401 (unauthorized).");
      return;
    }
    
    const responseData = res.getBody();
  
    // 1️⃣ Grundsätzliche Strukturprüfung
    expect(responseData).to.be.an("object");
    expect(responseData.resourceType, "resourceType should be defined").to.be.a("string");
  
    // 2️⃣ Fall 1: Bundle vom Typ searchset
    if (responseData.resourceType === "Bundle") {
      expect(responseData.type).to.equal("searchset");
  
      const entries = responseData.entry || [];
      expect(
        entries.length,
        `Expected searchset bundle to be empty, but found ${entries.length} entries`
      ).to.equal(0);
    }
  
    // 3️⃣ Fall 2: OperationOutcome
    else if (responseData.resourceType === "OperationOutcome") {
      const issues = responseData.issue || [];
  
      expect(
        issues.length,
        "Expected OperationOutcome to contain at least one issue"
      ).to.be.greaterThan(0);
  
      // Log optional alle severities für Debug-Zwecke
      console.log(
        "OperationOutcome severities:",
        issues.map(i => i.severity).join(", ")
      );
    }
  
    // 4️⃣ Falls etwas anderes zurückkommt → Fehler
    else {
      throw new Error(
        `Unexpected resourceType '${responseData.resourceType}'. Expected 'Bundle' or 'OperationOutcome'.`
      );
    }
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
