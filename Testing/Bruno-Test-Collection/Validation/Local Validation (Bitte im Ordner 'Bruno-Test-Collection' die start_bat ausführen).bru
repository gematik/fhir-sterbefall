meta {
  name: Local Validation (Bitte im Ordner 'Bruno-Test-Collection' die start_bat ausführen)
  type: http
  seq: 1
  tags: [
    ga
  ]
}

post {
  url: http://localhost:8081/validateResource
  body: json
  auth: inherit
}

body:json {
  {{validExportBundle}}
}

tests {
  test("FHIR VALIDATION: Needed resources and correct STF profiles", () => {
    const input = req.getBody();
    expect(input.resourceType).to.equal("Bundle");
  
    const entries = input.entry || [];
  
    // 🧩 Definiere benötigte Ressourcen und die zulässigen Profile
    const expectedResources = new Map([
      ["Patient", [
        "http://gematik.de/fhir/oegd/stf/StructureDefinition/StfVerstorbenePerson"
      ]],
      ["Organization", [
        "http://gematik.de/fhir/oegd/stf/StructureDefinition/StfOrganisation"
      ]],
      ["Practitioner", [
        "http://gematik.de/fhir/oegd/stf/StructureDefinition/StfArzt"
      ]],
      ["PractitionerRole", [
        "http://gematik.de/fhir/oegd/stf/StructureDefinition/StfArztZuordnung"
      ]],
      ["Procedure", [
        "http://gematik.de/fhir/oegd/stf/StructureDefinition/StfObduktion",
        "http://gematik.de/fhir/oegd/stf/StructureDefinition/StfLeichenschau"
      ]],
      ["ServiceRequest", [
        "http://gematik.de/fhir/oegd/stf/StructureDefinition/StfObduktionAnfrage"
      ]],
      ["Observation", [
        "http://gematik.de/fhir/oegd/stf/StructureDefinition/StfTodesursache",
        "http://gematik.de/fhir/oegd/stf/StructureDefinition/StfObservationKrebserkrankung"
      ]],
      ["Provenance", [
        "http://gematik.de/fhir/oegd/stf/StructureDefinition/StfSterbeurkundeAusstellung"
      ]],
      ["DocumentReference", [
        "http://gematik.de/fhir/oegd/stf/StructureDefinition/StfDatei"
      ]]
    ]);
  
    // 🔍 1️⃣ Prüfen, ob alle benötigten Ressourcentypen im Bundle vorhanden sind
    const resourceTypesInBundle = entries.map(e => e.resource?.resourceType);
    const missing = [...expectedResources.keys()].filter(
      needed => !resourceTypesInBundle.includes(needed)
    );
  
    expect(
      missing.length,
      `Fehlende Ressourcen im Bundle: ${missing.join(", ")}`
    ).to.equal(0);
  
    // 🔗 2️⃣ Prüfen, ob jede Ressource mindestens ein korrektes Profil trägt
    const invalidProfiles = [];
  
    entries.forEach((entry, index) => {
      const res = entry.resource;
      const type = res?.resourceType;
      const expectedProfiles = expectedResources.get(type);
  
      if (expectedProfiles) {
        const profiles = res?.meta?.profile || [];
        const hasAtLeastOneCorrect = profiles.some(p => expectedProfiles.includes(p));
  
        if (!hasAtLeastOneCorrect) {
          invalidProfiles.push(
            `${type} (Entry ${index}) hat kein passendes Profil. Erwartet eines von: ${expectedProfiles.join(", ")}; gefunden: ${profiles.join(", ") || "–"}`
          );
        }
      }
    });
  
    expect(
      invalidProfiles.length,
      "Folgende Ressourcen haben kein korrektes Profil:\n" + invalidProfiles.join("\n")
    ).to.equal(0);
  
    console.log("✅ Alle benötigten Ressourcen und mindestens ein passendes Profil sind vorhanden.");
  });
  
  function stripIcd10DisplayErrors(operationOutcome) {
    if (!operationOutcome || !Array.isArray(operationOutcome.issue)) {
      return operationOutcome;
    }
  
    operationOutcome.issue = operationOutcome.issue.filter(issue => {
      const severity = issue.severity;
      const text = issue?.details?.text || "";
  
      const isError = severity === "error";
      const mentionsIcd10 = text.includes("http://hl7.org/fhir/sid/icd-10");
      const mentionsWrongDisplay = text.toLowerCase().includes("wrong display name");
  
      const isIcd10DisplayError = isError && mentionsIcd10 && mentionsWrongDisplay;
  
      // Nur diese fliegen raus
      return !isIcd10DisplayError;
    });
  
    return operationOutcome;
  }
  
  test("FHIR VALIDATION: Request body is valid according to JAVA validator", () => {
    var validation = res.getBody();
    
    validation = stripIcd10DisplayErrors(validation);
    
    expect(validation.resourceType).to.equal("OperationOutcome");
  
    const issues = validation.issue;
    const errors = issues.filter(i => i.severity === "error");
    const warnings = issues.filter(i => i.severity === "warning");
  
    console.log(errors.map(e => e.details.text).join("\n "));
    
    console.log(`FHIR Validation found ${errors.length} errors and ${warnings.length} warnings.`);
  
    expect(errors.length, `FHIR validation failed: ${errors.map(e => e.details.text).join(" —— ")}`).to.equal(0);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
