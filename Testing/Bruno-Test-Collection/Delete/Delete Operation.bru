meta {
  name: Delete Operation
  type: http
  seq: 3
  tags: [
    kr
  ]
}

post {
  url: {{host}}/Provenance/{{createdProvenanceId}}/$deleteBundle
  body: none
  auth: inherit
}

body:json {
  {{batchRequestBody}}
}

assert {
  res.status: eq 200
}

script:pre-request {
  const step1 = bru.getVar("Delete_Step2");
  
  if (step1 !== "success") {
    throw new Error("[SKIP] Dependency Request Step 1 failed — skipping execution.");
  }
}

tests {
  test("DELETE: OperationOutcome enthält nur erfolgreiche Delete-Diagnostics", () => {
    const body = res.getBody();
  
    // Grundstruktur prüfen
    expect(body.resourceType).to.equal("OperationOutcome");
    expect(body.issue).to.be.an("array").that.is.not.empty;
  
    const issues = body.issue || [];
  
    // Erlaubt:
    // - "Deleted <Resource>/<id> -> 410 Gone"
    // - "deleteBundle abgeschlossen (transaktional)."
    const invalidIssues = issues
      .map((issue, idx) => {
        const diagnostics = issue.diagnostics || "(missing diagnostics)";
        const severity = issue.severity || "(missing severity)";
        const code = issue.code || "(missing code)";
  
        const isDeletedEntry = /^Deleted\s+[A-Za-z]+\/[A-Za-z0-9.-]+\s+->\s+410\s+Gone$/.test(diagnostics);
        const isTransactionDone = diagnostics === "deleteBundle abgeschlossen (transaktional).";
  
        return {
          index: idx,
          severity,
          code,
          diagnostics,
          ok: isDeletedEntry || isTransactionDone
        };
      })
      .filter(i => !i.ok);
  
    // Debug-Übersicht
    console.log(
      "🔎 Delete-Diagnostics pro Issue:",
      issues.map((issue, idx) => `${idx}: ${issue.diagnostics || "(missing diagnostics)"}`)
    );
  
    // Zusatzcheck: Es sollte mindestens ein echter Delete-Eintrag vorhanden sein
    const deleteEntries = issues.filter(issue =>
      /^Deleted\s+[A-Za-z]+\/[A-Za-z0-9.-]+\s+->\s+410\s+Gone$/.test(issue.diagnostics || "")
    );
  
    expect(
      deleteEntries.length,
      "Erwarte mindestens einen Diagnostics-Eintrag im Format 'Deleted <Resource>/<id> -> 410 Gone'."
    ).to.be.greaterThan(0);
  
    // Erwartung: Alle Issues müssen entweder Delete-Erfolg oder Abschlussmeldung sein
    expect(
      invalidIssues.length,
      invalidIssues.length > 0
        ? `Erwarte nur erfolgreiche Delete-Diagnostics oder die Abschlussmeldung.\nAbweichungen:\n${invalidIssues
            .map(i => `Issue[${i.index}] severity=${i.severity}, code=${i.code}, diagnostics=${i.diagnostics}`)
            .join("\n")}`
        : "Alle Issues enthalten gültige Delete-Diagnostics."
    ).to.equal(0);
  
    console.log("✅ OperationOutcome enthält nur erfolgreiche Delete-Diagnostics.");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
