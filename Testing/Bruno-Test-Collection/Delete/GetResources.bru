meta {
  name: GetResources
  type: http
  seq: 4
  tags: [
    kr
  ]
}

post {
  url: {{host}}/
  body: json
  auth: inherit
}

body:json {
  {{deleteBatchRequestBody}}
}

script:pre-request {
  const step1 = bru.getVar("Delete_Step2");
  
  if (step1 !== "success") {
    throw new Error("[SKIP] Dependency Request Step 2 failed — skipping execution.");
  }
}

tests {
  test("DELETE: All batch-response entries are 410 Gone", () => {
    const body = res.getBody();
  
    expect(body.resourceType).to.equal("Bundle");
    expect(body.type).to.equal("batch-response");
    expect(body.entry).to.be.an("array").that.is.not.empty;
  
    const entries = body.entry || [];
  
    const nonGone = entries
      .map((e, idx) => ({
        index: idx,
        status: e.response?.status || "(missing)"
      }))
      .filter(e => e.status !== "410 Gone");
  
    // Debug-Übersicht
    console.log(
      "🔎 Status pro Entry:",
      entries.map((e, idx) => {
        const res = e.resource;
        const label = res ? `${res.resourceType}/${res.id || "?"}` : `(Entry[${idx}] ohne Resource)`;
        return `${idx}: ${label} -> ${e.response?.status || "(missing)"}`;
      })
    );
  
    expect(
      nonGone.length,
      nonGone.length > 0
        ? `Erwarte für alle Einträge Status "410 Gone". Abweichungen:\n` +
          nonGone
            .map(e => `Entry[${e.index}] ${e.resourceLabel}: ${e.status}`)
            .join("\n")
        : "Alle Einträge sind 410 Gone."
    ).to.equal(0);
  
    console.log("✅ Alle Einträge im batch-response sind 410 Gone.");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
