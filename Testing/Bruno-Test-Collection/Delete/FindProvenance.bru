meta {
  name: FindProvenance
  type: http
  seq: 2
}

get {
  url: {{host}}/Provenance?target:Patient={{createdpatientId}}&_profile=http://gematik.de/fhir/oegd/stf/StructureDefinition/StfExportProvenance
  body: none
  auth: inherit
}

params:query {
  "target:Patient": {{createdpatientId}}
  _profile: http://gematik.de/fhir/oegd/stf/StructureDefinition/StfExportProvenance
}

script:post-response {
  const json = res.getBody();
  
  const provenanceRef = json.entry?.[0].fullUrl;
  if (!provenanceRef) {
    bru.setVar("Delete_Step1", "failed");
    throw new Error("No Provenance resource found from step 1!");
  }
  const provenanceId = provenanceRef.split("/")[5];
  // Patient-ID separat speichern
  bru.setVar("createdProvenanceId", provenanceId);
}

settings {
  encodeUrl: true
  timeout: 0
}
