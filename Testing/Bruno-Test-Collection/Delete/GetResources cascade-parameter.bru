meta {
  name: GetResources cascade-parameter
  type: http
  seq: 3
  tags: [
    kr
  ]
}

delete {
  url: {{host}}/Patient/{{createdPatientId}}?_cascade=delete
  body: none
  auth: inherit
}

params:query {
  _cascade: delete
}

body:json {
  {{batchRequestBody}}
}

assert {
  res.status: eq 200
}

script:pre-request {
  const step1 = bru.getVar("Delete_Step1");
  
  if (step1 !== "success") {
    throw new Error("[SKIP] Dependency Request Step 1 failed — skipping execution.");
  }
}

tests {
  test("DELETE: OperationOutcome shows SUCCESSFUL_DELETE oder SUCCESSFUL_DELETE_ALREADY_DELETED", () => {
    const body = res.getBody();
  
    expect(body.resourceType).to.equal("OperationOutcome");
    expect(body.issue).to.be.an("array").that.is.not.empty;
  
    const issues = body.issue || [];
  
    const hasSuccessfulDelete = issues.some(issue =>
      Array.isArray(issue.details?.coding) &&
      issue.details.coding.some(coding => coding.code === "SUCCESSFUL_DELETE")
    );
  
    const hasSuccessfulDeleteAlreadyDeleted = issues.some(issue =>
      Array.isArray(issue.details?.coding) &&
      issue.details.coding.some(coding => coding.code === "SUCCESSFUL_DELETE_ALREADY_DELETED")
    );
  
    const ok = hasSuccessfulDelete || hasSuccessfulDeleteAlreadyDeleted;
  
    expect(
      ok,
      "Erwarte OperationOutcome mit SUCCESSFUL_DELETE oder SUCCESSFUL_DELETE_ALREADY_DELETED"
    ).to.be.true;
  
    console.log(
      hasSuccessfulDelete
        ? "✅ Delete-OperationOutcome enthält SUCCESSFUL_DELETE."
        : "✅ Delete-OperationOutcome enthält SUCCESSFUL_DELETE_ALREADY_DELETED."
    );
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
