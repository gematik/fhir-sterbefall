assert {
  res.status: eq 422
}

tests {
  test("FHIR VALIDATION: Request body is valid according to JAVA validator", () => {
    const validation = res.getBody();
    expect(validation.resourceType).to.equal("OperationOutcome");
  
    const issues = validation.issue;
    const errors = issues.filter(i => i.severity === "error");
    const warnings = issues.filter(i => i.severity === "warning");
  
    console.log(errors.map(e => e.diagnostics).join("\n "));
    
    console.log(`FHIR Validation found ${errors.length} errors and ${warnings.length} warnings.`);
  
    expect(errors.length, `FHIR validation failed with expected 2 error: ${errors.map(e => e.diagnostics).join(" —— ")}`).to.equal(2);
  });
}

settings {
  encodeUrl: true
