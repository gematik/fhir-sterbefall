meta {
  name: Erfolgsfall Bundle
  type: http
  seq: 1
  tags: [
    kr
  ]
}

post {
  url: {{host}}/$receiveBundle
  body: json
  auth: inherit
}

body:json {
  {{validExportBundle}}
}

assert {
  res.status: eq 200
}

script:post-response {
  // 🧩 Extract IDs from transaction-response
  const response = res.getBody();
  
  if (response.resourceType !== "Bundle" || response.type !== "transaction-response") {
    bru.setVar("Persistence_Step1", "failed");
    throw new Error("Response is not a FHIR transaction-response Bundle.");
  }
  
  const getUrls = response.entry
    .map(e => e.response?.location)
    .filter(Boolean)
    .map(loc => {
      // remove "_history" suffix → only base resource path
      const clean = loc.split("/_history")[0];
      return clean;
    });
  
  if (getUrls.length === 0) {
    throw new Error("No resource locations found in response!");
  }
  
  // 🧱 Build new batch Bundle
  const batchBundle = {
    resourceType: "Bundle",
    id: "bundle-request",
    type: "batch",
    entry: getUrls.map(url => ({
      request: {
        method: "GET",
        url // e.g. "Patient/152"
      }
    }))
  };
  
  // 💾 Store bundle as JSON string for next request
  bru.setVar("batchRequestBody", JSON.stringify(batchBundle, null, 2));
  bru.setVar("Persistence_Step1", "success");
  console.log("✅ Built batch bundle with", getUrls.length, "entries.");
  
}

tests {
  test("REQUEST: Correct Bundle Type: collection", () => {
    const jsonData = req.getBody();
    const bundleType = jsonData.type;
  
    expect(bundleType).to.equal("collection");
  });
  
  test("RESPONSE: Bundle Type: transaction-response", () => {
    const jsonData = res.getBody();
    const bundleType = jsonData.type;
  
    expect(bundleType).to.equal("transaction-response");
  });
  
  test("RESPONSE: Number of responses matches number of request resources", () => {
    const requestData = req.getBody();
    const responseData = res.getBody();
  
    const requestEntries = requestData.entry;
    const responseEntries = responseData.entry;
  
    expect(requestEntries).to.be.an("array");
    expect(responseEntries).to.be.an("array");
  
    expect(
      responseEntries.length,
      `Expected ${requestEntries.length} responses, got ${responseEntries.length}`
    ).to.equal(requestEntries.length);
  });
  
  test("RESPONSE: All responses have status 201 Created", () => {
    const responseData = res.getBody();
    const entries = responseData.entry;
  
    expect(entries).to.be.an("array").that.is.not.empty;
  
    entries.forEach((entry, index) => {
      const status = entry.response?.status;
      expect(status, `Entry ${index} status`).to.be.a("string");
      expect(
        status,
        `Entry ${index} expected status '201 Created' but got '${status}'`
      ).to.equal("201 Created");
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
